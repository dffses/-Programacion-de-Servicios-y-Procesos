#include <stdlib.h>
#include <unistd.h>
#include <stdio.h>
#include <sys/types.h>
#include <sys/wait.h>


void main(){

    pid_t  p_p1,p_p2,p_p3,p_p4,p_p5,p_p6;
    printf("Soy el p1 y mi pid es: %d\n",getpid());
    p_p2=fork();

    if (p_p2==0)
    {
        p_p1=getppid();
        p_p2=getpid();
        printf("Soy el p2 y mi pid es: %d\n",p_p2);

        p_p3=fork();
        if (p_p3==0)
        {
            p_p3=getpid();
            printf("Soy el p3 y mi pid es: %d y el de mi abuelo es: %d\n",p_p3,p_p1);

            p_p5=fork();
            if (p_p5==0)
            {
                p_p5=getpid();
                printf("Soy el p5 y mi pid es: %d y el de mi abuelo es: %d\n",p_p5,p_p2);
            }else
            {
                wait(NULL);
            }
            
            
        }else
        {
            wait(NULL);

             p_p4=fork();
         if (p_p4==0)
        {
            p_p4=getpid();
            printf("Soy el p4 y mi pid es: %d y el de mi abuelo es: %d\n",p_p4,p_p1);

            p_p6=fork();
            if (p_p6==0)
            {
                p_p6=getpid();
                printf("Soy el p6 y mi pid es: %d y el de mi abuelo es: %d\n",p_p6,p_p2);
            }else
            {
                wait(NULL);
            }
        }else
        {
            wait(NULL);
        }
        }
        
        
    }else
    {
        wait(NULL);
    }
    
    
}
