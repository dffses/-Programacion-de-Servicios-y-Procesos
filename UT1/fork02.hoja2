#include <stdlib.h>
#include <unistd.h>
#include <stdio.h>
#include <sys/types.h>
#include <sys/wait.h>


void main(){
    pid_t  p_p1,p_p2,p_p3,p_p4;
    printf("Soy el proceso padre y mi pid es: %d\n",getpid());
    
    p_p2=fork();
    

    if (p_p2==0)
    {
        p_p1=getppid();
        p_p2=getpid();
        printf("Soy el p2 y mi pid es: %d y el de mi padre es: %d y la suma de ambos es: %d\n",p_p2,p_p1,(p_p1+p_p2));
        
        p_p3=fork();
        if (p_p3==0)
        {
            p_p3=getpid();
            printf("Soy el p3 y mi pid es: %d y el de mi padre es: %d y la suma de ambos es: %d\n",p_p3,p_p2,(p_p3+p_p2));
            
            p_p4=fork();
            if (p_p4==0)
            {
                p_p4=getpid();
                printf("Soy el p4 y mi pid es: %d y el de mi padre es: %d y la suma de ambos es: %d\n",p_p4,p_p3,(p_p4+p_p3));
            }else
            {
                wait(NULL);
                
            }
        }else
        {
            wait(NULL);
            
        }
    }else
    {
        wait(NULL);
        
    }
}
